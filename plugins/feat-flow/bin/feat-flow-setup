#!/usr/bin/env bash
# feat-flow-setup — 项目初始化脚本
# 插件安装后，每个开发者在本地运行一次

set -euo pipefail

SETUP_VERSION="1.0.0"
PASS=0
FAIL=0

ok()   { echo "  ✅ $1"; PASS=$((PASS+1)); }
fail() { echo "  ❌ $1"; FAIL=$((FAIL+1)); }
warn() { echo "  ⚠️  $1"; }

echo ""
echo "feat-flow-setup v${SETUP_VERSION}"
echo "══════════════════════════════════════"

# ── 1. Node.js 检测 ──────────────────────────────────────────────────────────
if ! command -v node &>/dev/null; then
  fail "未找到 Node.js"
  echo ""
  echo "  请先安装 Node.js（建议 LTS 版本 v20 或以上）："
  echo ""
  echo "    macOS:    brew install node"
  echo "    Windows:  https://nodejs.org 下载安装包"
  echo "    Linux:    https://nodejs.org 或使用系统包管理器"
  echo "    通用:     https://github.com/nvm-sh/nvm （版本管理器，推荐）"
  echo ""
  echo "❌ setup 失败，请安装 Node.js 后重试"
  exit 1
fi

NODE_VERSION=$(node --version)
ok "Node.js ${NODE_VERSION}"

# 检测 npx（随 Node.js 一起安装，通常都有）
if ! command -v npx &>/dev/null; then
  fail "未找到 npx（应随 Node.js 一起安装）"
  echo "  请更新 Node.js 到 v16 或以上版本，npx 会自动包含。"
  echo ""
  echo "❌ setup 失败"
  exit 1
fi
ok "npx 可用"

# ── 2. git 仓库检测 ──────────────────────────────────────────────────────────
if ! git rev-parse --show-toplevel &>/dev/null; then
  fail "当前目录不是 git 仓库。请 cd 到项目根目录后重新运行。"
  echo ""
  echo "❌ setup 失败"
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"
ok "git 仓库 (${REPO_ROOT})"

# ── 3. Claude Code 目录检测 ──────────────────────────────────────────────────
if [ ! -d ".claude" ]; then
  warn ".claude/ 目录不存在，将自动创建"
  mkdir -p .claude
fi
ok "Claude Code 项目目录"

# ── 4. .gitignore 更新 ───────────────────────────────────────────────────────
GITIGNORE=".gitignore"
NEEDED_ENTRIES=(
  ".feat-flow/secret"
  ".feat-flow/gate-token"
  ".feat-flow/state.json"
  ".feat-flow/violations.log"
  ".feat-flow/.initialized"
  ".feat-flow/*.tmp"
  ".feat-flow/transitions.log"
)

ADDED=0
for entry in "${NEEDED_ENTRIES[@]}"; do
  if ! grep -qF "$entry" "$GITIGNORE" 2>/dev/null; then
    echo "$entry" >> "$GITIGNORE"
    ADDED=$((ADDED+1))
  fi
done

if [ $ADDED -gt 0 ]; then
  ok ".gitignore 已更新（添加 ${ADDED} 条 feat-flow 条目）"
else
  ok ".gitignore 已包含所有 feat-flow 条目"
fi

# ── 5. .feat-flow 目录初始化 ─────────────────────────────────────────────────
mkdir -p .feat-flow

cat > .feat-flow/.initialized << MARKER
{
  "setup_version": "${SETUP_VERSION}",
  "setup_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "gitignore_ok": true
}
MARKER

ok ".feat-flow/ 已初始化"

# ── 完成 ─────────────────────────────────────────────────────────────────────
echo ""
if [ $FAIL -gt 0 ]; then
  echo "❌ setup 完成，但有 ${FAIL} 项失败，请检查以上错误"
  exit 1
else
  echo "✅ feat-flow setup 完成！（${PASS} 项通过）"
  echo ""
  echo "  开始使用："
  echo "  feat-flow start <需求描述>"
  echo ""
fi
