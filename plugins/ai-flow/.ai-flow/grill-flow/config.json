{
  "schema_version": "1.0",
  "name": "grill-flow",
  "description": "mattpocock v1.1 方法论工作流（散文 spec + tracer-bullet 切片 + 主 session 只调度、实施与评审全外包子代理）：5 stage 覆盖需求对齐（含 wayfinder 迷雾子模式）→ 散文规格+方案审查+切片（每票声明 Blocked by / Touches）→ 逐票实施（写集不相交的票各开 worktree 并行，opus 实施 + opus 质量链三评审 Standards/Spec/correctness + 注释清理，rebase 适配 + ff-only 回合、历史线性）→ 收尾组装审 → 知识沉淀。设计迷雾大走 stage-1 的 wayfinder 子模式。",
  "context": {
    "wrap_up_at_pct": 60
  },
  "stages": [
    {
      "id": "stage-1",
      "name": "需求对齐",
      "prompt": "stages/stage-1.md",
      "write_scope": "docs_only",
      "docs_paths": ["docs/grill-flows/"],
      "completion": { "gate": true }
    },
    {
      "id": "stage-2",
      "name": "写规格与切票",
      "prompt": "stages/stage-2.md",
      "write_scope": "docs_only",
      "docs_paths": ["docs/grill-flows/"],
      "completion": {
        "script": { "command": "node scripts/gate-stage-2.cjs" },
        "gate": true
      }
    },
    {
      "id": "stage-3",
      "name": "逐票实施",
      "prompt": "stages/stage-3.md",
      "write_scope": "unrestricted",
      "docs_paths": ["docs/grill-flows/"],
      "completion": {
        "script": { "command": "node scripts/gate-stage-3.cjs" }
      },
      "stop_guard": "node scripts/stop-guard.cjs"
    },
    {
      "id": "stage-4",
      "name": "整体评审与合并",
      "prompt": "stages/stage-4.md",
      "write_scope": "unrestricted",
      "docs_paths": ["docs/grill-flows/"],
      "completion": { "gate": true }
    },
    {
      "id": "stage-5",
      "name": "知识沉淀",
      "prompt": "stages/stage-5.md",
      "write_scope": "unrestricted",
      "docs_paths": ["docs/grill-flows/"],
      "completion": { "gate": true }
    }
  ]
}
