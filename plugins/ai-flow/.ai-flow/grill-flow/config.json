{
  "schema_version": "1.0",
  "name": "grill-flow",
  "description": "mattpocock v1.1 方法论工作流（散文 spec + tracer-bullet 切片 + 主 session 只调度、实施与评审全外包子代理）：5 stage 覆盖需求对齐（含 wayfinder 迷雾子模式）→ 散文规格+方案审查+切片（每票声明 Blocked by / Touches）→ 逐票实施（写集不相交的票各开 worktree 并行，sonnet 实施 + 并行 opus 三评审 Standards/Spec/correctness + simplify + 注释清理，rebase 适配 + ff-only 回合、历史线性）→ 收尾组装审 → 知识沉淀。与 feat-flow 并存对比，实现规模不限；设计迷雾大走 stage-1 的 wayfinder 子模式。",
  "context": {
    "warn_at_pct": 50,
    "rewarn_delta_pct": 10,
    "block_at_pct": 60
  },
  "stages": [
    {
      "id": "stage-1",
      "prompt": "stages/stage-1.md",
      "write_scope": "docs_only",
      "docs_paths": ["docs/grill-flows/"],
      "completion": { "gate": true }
    },
    {
      "id": "stage-2",
      "prompt": "stages/stage-2.md",
      "write_scope": "docs_only",
      "docs_paths": ["docs/grill-flows/"],
      "completion": {
        "script": { "command": "node scripts/gate-stage-2.cjs" },
        "gate": true
      }
    },
    {
      "id": "stage-3",
      "prompt": "stages/stage-3.md",
      "write_scope": "unrestricted",
      "completion": {
        "script": { "command": "node scripts/gate-stage-3.cjs" }
      }
    },
    {
      "id": "stage-4",
      "prompt": "stages/stage-4.md",
      "write_scope": "unrestricted",
      "completion": { "gate": true }
    },
    {
      "id": "stage-5",
      "prompt": "stages/stage-5.md",
      "write_scope": "unrestricted",
      "completion": { "gate": true }
    }
  ]
}
