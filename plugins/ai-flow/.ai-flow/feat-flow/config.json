{
  "schema_version": "1.0",
  "name": "feat-flow",
  "description": "功能需求开发工作流：6 stage 覆盖需求确认 → 实施蓝图 → 实施计划 → 代码实施 → 质量门 → 知识沉淀。设计哲学：context 长期健康、/clear 安全持久化、知识基础设施自动建立与维护。",
  "context": {
    "wrap_up_at_pct": 60
  },
  "stages": [
    {
      "id": "stage-1",
      "name": "需求确认",
      "prompt": "stages/stage-1.md",
      "write_scope": "docs_only",
      "docs_paths": ["docs/feat-flows/"],
      "completion": { "gate": true }
    },
    {
      "id": "stage-2",
      "name": "实施蓝图",
      "prompt": "stages/stage-2.md",
      "write_scope": "docs_only",
      "docs_paths": ["docs/feat-flows/"],
      "completion": { "gate": true }
    },
    {
      "id": "stage-3",
      "name": "实施计划",
      "prompt": "stages/stage-3.md",
      "write_scope": "docs_only",
      "docs_paths": ["docs/feat-flows/"],
      "completion": {}
    },
    {
      "id": "stage-4",
      "name": "代码实施",
      "prompt": "stages/stage-4.md",
      "write_scope": "unrestricted",
      "docs_paths": ["docs/feat-flows/"],
      "completion": {}
    },
    {
      "id": "stage-5",
      "name": "质量门与合并",
      "prompt": "stages/stage-5.md",
      "write_scope": "unrestricted",
      "docs_paths": ["docs/feat-flows/"],
      "completion": { "gate": true }
    },
    {
      "id": "stage-6",
      "name": "知识沉淀",
      "prompt": "stages/stage-6.md",
      "write_scope": "unrestricted",
      "docs_paths": ["docs/feat-flows/"],
      "completion": { "gate": true }
    }
  ]
}
