{
  "name": "ai-flow",
  "version": "0.22.0",
  "private": true,
  "type": "module",
  "author": "Darian Deng <imdengxianyu@qq.com>",
  "scripts": {
    "build": "esbuild src/hooks/userprompt.ts src/hooks/posttool.ts src/hooks/pretool.ts src/hooks/session.ts --bundle --platform=node --target=node18 --format=esm --outdir=dist/hooks",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
